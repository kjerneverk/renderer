{
    "name": "@riotprompt/riotplan-renderer",
    "version": "0.0.1",
    "description": "Render RiotPlan plans to various formats",
    "type": "module",
    "main": "dist/index.cjs",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "types": "./dist/index.d.ts"
        }
    },
    "scripts": {
        "build": "tsc && vite build",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "lint": "eslint src tests",
        "lint:fix": "eslint src tests --fix",
        "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
        "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts'",
        "typecheck": "tsc --noEmit",
        "precommit": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
    },
    "keywords": [
        "riotplan",
        "renderer",
        "markdown",
        "json",
        "html",
        "export"
    ],
    "author": "Tim O'Brien",
    "license": "MIT",
    "dependencies": {
        "@riotprompt/riotplan": "file:../riotplan"
    },
    "devDependencies": {
        "@eslint/js": "^8.57.0",
        "@types/node": "^22.10.2",
        "@typescript-eslint/eslint-plugin": "^7.8.0",
        "@typescript-eslint/parser": "^7.8.0",
        "@vitest/coverage-v8": "^2.1.8",
        "eslint": "^8.57.0",
        "eslint-config-prettier": "^9.1.0",
        "eslint-plugin-prettier": "^5.1.3",
        "prettier": "^3.2.5",
        "typescript": "^5.7.2",
        "typescript-eslint": "^7.8.0",
        "vite": "^6.0.6",
        "vite-plugin-dts": "^4.4.0",
        "vitest": "^2.1.8"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "engines": {
        "node": ">=18.0.0"
    }
}

